# Ignore everything not needed by the infra/docker/*.Dockerfile builds so the
# build context stays small and clean rebuilds are reproducible.
.git
**/node_modules
**/.next
**/dist
**/.expo
**/coverage
**/*.log
**/.env
**/.env.*
!**/.env.template
.expo
android
ios
docs
.claude
.agents
railway
infra
.github
CONTEXT-MAP.md

# Remote PR seed in the API image needs only the bucket bootstrap contract.
!infra
infra/*
!infra/minio
infra/minio/*
!infra/minio/bootstrap.mjs
!infra/minio/contract.mjs
