{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["**/.env.*local", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "APP_ENV", "LOG_LEVEL"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "TOTP_SECRET_ENCRYPTION_KEY",
    "MINIO_ENDPOINT",
    "MINIO_PUBLIC_URL",
    "MINIO_ACCESS_KEY",
    "MINIO_SECRET_KEY",
    "MINIO_REGION",
    "REPORT_ENTRY_ENABLED",
    "ADMIN_MODERATION_ACTIONS_ENABLED",
    "TESTCONTAINERS_RYUK_DISABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**"]
    },
    "@auto-tm/db#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "generated/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@auto-tm/db#lint": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "@auto-tm/db#typecheck": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "@auto-tm/db#test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "@auto-tm/db#test:unit": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "@auto-tm/api#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/admin/src/lib/**", "$TURBO_ROOT$/apps/admin/package.json"],
      "outputs": []
    },
    "@auto-tm/api#test:unit": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/admin/src/lib/**", "$TURBO_ROOT$/apps/admin/package.json"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
