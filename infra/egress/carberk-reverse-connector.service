[Unit]
Description=Carberk fixed-origin reverse CONNECT adapter
After=carberk-reverse.service
Wants=carberk-reverse.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
DynamicUser=yes
ExecStart=/opt/carberk-gateway/current/node/bin/node /opt/carberk-reverse/reverse-connector.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=128M
CPUQuota=50%
TasksMax=32
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
