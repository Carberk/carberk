# Additive virtual host in the existing Snikket nginx http context.
# Render the owned staging hostname and its certificate before approved activation.
# Persist as a read-only file mount at /etc/nginx/conf.d/carberk.conf.
# Leave every existing Snikket server, certificate and port unchanged.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name tm-staging.example.invalid;
    ssl_certificate /run/carberk/tls/fullchain.pem;
    ssl_certificate_key /run/carberk/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    gzip off;
    access_log off; # Signed queries and bearer material must not enter access logs.
    error_log /dev/stderr crit;
    client_max_body_size 16m;
    client_body_timeout 30s;
    send_timeout 30s;
    location / {
        proxy_pass http://127.0.0.1:11880;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 3s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_redirect off;
        proxy_next_upstream off;
    }
}
