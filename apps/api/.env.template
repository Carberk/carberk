# apps/api — environment template
# Copy to .env (gitignored) for local development.
# Railway-era deployed environments (ADR-0039) receive variables from the
# Railway dashboard per the checked-in matrix in railway/README.md — never
# commit real values here.

# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
# Deployed-environment identity: development | staging | production | test.
# staging/production turn on fail-closed validation (no loopback endpoints,
# no cross-environment hosts, no placeholder/default secrets, no wildcard
# Socket.IO CORS in production). Railway sets this per environment.
APP_ENV=development
# Baked into the image at build time from RAILWAY_GIT_COMMIT_SHA
# (infra/docker/api.Dockerfile); surfaced by /healthz and /readyz.
AUTOTM_COMMIT_SHA=unknown
PORT=3006
LOG_LEVEL=info                                # error | warn | info | debug

# ─── Database (Prisma) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://auto_tm:auto_tm_pass@localhost:5432/auto_tm_dev

# ─── Cache + queue ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (JWT) ─────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_me_with_64_char_random_access_secret
JWT_REFRESH_SECRET=replace_me_with_64_char_random_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
TOTP_SECRET_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA= # 32-byte base64; replace in production

# ─── SMS gateway (OTP delivery) ─────────────────────────────────────────
SMS_GATEWAY_URL=http://localhost:3090
SMS_GATEWAY_TOKEN=replace_me_with_random_token
SMS_DRIVER=mock                               # mock | test | gateway

# ─── OTP test mode (CI only) ────────────────────────────────────────────
# Fail-closed (Sprint 11 / ADR-0039): both flags only validate when
# NODE_ENV=test. Enabling them in any real environment fails boot.
OTP_TEST_MODE=false                           # Returns OTP code in API response — CI only
OTP_TEST_CODE_RESPONSE=false

# ─── Store-review demo auth (secret-managed; disabled by default) ───────
# Enables fixed-code OTP bypass for 3-5 pre-existing, unissueable buyer/seller
# reviewer accounts only. Values belong in Railway/store-review secret stores,
# never in git or issue text.
REVIEW_DEMO_ACCOUNT_ENABLED=false
REVIEW_DEMO_ACCOUNTS_JSON=[]                  # [{"phone":"+993XXXXXXXX","email":"reviewer@example.com","code":"NNNNNN"}, ...]
# Required only while running `pnpm --filter @auto-tm/db reviewer:scenario`.
# This is an explicit operator authorization, not a credential value.
REVIEWER_SCENARIO_SEED_AUTHORIZATION=

# ─── Push notifications ─────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=                              # Multi-line value — escape \n in env

APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=tm.auto.app
APNS_PRIVATE_KEY=

PUSH_TRANSPORT=test                           # fcm-apns | ntfy | test

# ─── Object storage (MinIO) ─────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000           # Private server endpoint for API/admin S3 operations
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://localhost:9000         # Public S3 endpoint used for media reads and presigned PUT URLs

# ─── VIN decoder ────────────────────────────────────────────────────────
VIN_DECODER_DRIVER=mock                       # mock | proxy
VIN_DECODER_URL=                              # TM Proxy PC URL (when DRIVER=proxy)

# ─── TM Proxy PC (outbound bridge) ──────────────────────────────────────
PROXY_PC_URL=                                 # Empty in dev; set in prod for external API access

# ─── Rate limiting overrides (optional) ─────────────────────────────────
RATE_LIMIT_GENERAL=60                         # requests/min/IP
RATE_LIMIT_OTP_PHONE_DAILY=5                  # OTP requests per phone per day
RATE_LIMIT_OTP_IP_HOURLY=10                   # OTP requests per IP per hour
# Which header carries the caller's IP for the rate limits above (ADR-0078).
# Railway's edge sets x-real-ip. For a proxy that appends to x-forwarded-for,
# set CLIENT_IP_HEADER=x-forwarded-for and CLIENT_IP_TRUSTED_HOPS to the number
# of proxies you run. A hop count is safe only when the API cannot be reached
# except through those proxies; a direct caller writes the whole list.
# `none` trusts no header and uses the peer address.
CLIENT_IP_HEADER=x-real-ip
CLIENT_IP_TRUSTED_HOPS=1

# ─── Realtime (Socket.IO) ───────────────────────────────────────────────
SOCKET_IO_NAMESPACE=/ws/chat                  # Socket.IO namespace for chat
SOCKET_IO_CORS_ORIGIN=*                       # CORS origin for browser/native clients
SOCKET_IO_REDIS_ADAPTER_ENABLED=false         # true = use @socket.io/redis-adapter via REDIS_URL

# ─── Launch-safety feature flags (MLP beta) ─────────────────────────────
SIGNUPS_ENABLED=true                          # false = block new OTP-created users while existing users can log in
REPORT_ENTRY_ENABLED=true                     # false = block public report creation (reads remain)
ADMIN_MODERATION_ACTIONS_ENABLED=true         # false = block admin moderation writes (reads remain)
INSPECTION_INTEREST_ENABLED=false             # false = block inspection-interest creation (admin reads remain)

# Keep disabled until #899 retention and EN/RU/TK + store disclosures are accepted.
LISTING_VIEWS_ENABLED=false
# Dedicated >=32-character stable secret, required only when enabled. Never reuse JWT secrets.
# LISTING_VIEW_SALT_SECRET=
