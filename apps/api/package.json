{
  "name": "@auto-tm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "predev": "pnpm --filter @auto-tm/db build && pnpm --filter @auto-tm/contracts build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --exclude '**/*.e2e.spec.ts' --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auto-tm/contracts": "workspace:*",
    "@auto-tm/db": "workspace:*",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/platform-fastify": "^11.1.16",
    "@nestjs/platform-socket.io": "^11.1.16",
    "bullmq": "catalog:",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.16",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "nestjs-pino": "catalog:",
    "otplib": "^13.4.1",
    "pino-http": "^10.4.0",
    "reflect-metadata": "catalog:",
    "rxjs": "^7.8.1",
    "sharp": "catalog:",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@auto-tm/eslint-config": "workspace:*",
    "@auto-tm/tsconfig": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "^11.1.20",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.33",
    "@swc/helpers": "^0.5.21",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.0",
    "@typescript/native": "catalog:",
    "chokidar": "^5.0.0",
    "socket.io-client": "catalog:",
    "supertest": "^7.2.2",
    "tsx": "catalog:",
