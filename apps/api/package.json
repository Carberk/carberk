{
  "name": "@auto-tm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "predev": "pnpm --filter @auto-tm/db build && pnpm --filter @auto-tm/contracts build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:unit": "AUTO_TM_TEST_DATABASES=off vitest run --exclude '**/*.e2e.spec.ts' --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auto-tm/contracts": "workspace:*",
    "@auto-tm/db": "workspace:*",
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.16",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/platform-fastify": "^11.1.16",
    "@nestjs/platform-socket.io": "^11.1.16",
    "bullmq": "^5.76.8",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.16",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.8.5",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.3.0",
    "otplib": "^13.4.1",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.1",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.1",
    "thumbhash": "0.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@auto-tm/eslint-config": "workspace:*",
    "@auto-tm/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.20",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.33",
    "@swc/helpers": "^0.5.21",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.0",
    "chokidar": "^5.0.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
