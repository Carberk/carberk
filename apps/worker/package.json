{
  "name": "@auto-tm/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "predev": "pnpm --filter @auto-tm/db build && pnpm --filter @auto-tm/contracts build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --exclude '**/*.e2e.spec.ts' --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@auto-tm/contracts": "workspace:*",
    "@auto-tm/db": "workspace:*",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@parse/node-apn": "^8.1.0",
    "bullmq": "^5.34.0",
    "firebase-admin": "^14.3.0",
    "ioredis": "catalog:",
    "nestjs-pino": "catalog:",
    "reflect-metadata": "catalog:",
    "resend": "^6.28.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@auto-tm/eslint-config": "workspace:*",
    "@auto-tm/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
