{
  "name": "@auto-tm/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "predev": "pnpm --filter @auto-tm/db build && pnpm --filter @auto-tm/contracts build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --exclude '**/*.e2e.spec.ts' --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@auto-tm/contracts": "workspace:*",
    "@auto-tm/db": "workspace:*",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.16",
    "@parse/node-apn": "^8.1.0",
    "bullmq": "^5.34.0",
    "firebase-admin": "^14.3.0",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.3.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@auto-tm/eslint-config": "workspace:*",
    "@auto-tm/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
