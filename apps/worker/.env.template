# apps/worker — environment template
# Worker shares most env vars with apps/api (it accesses the same DB + Redis + MinIO + push transports).
# Keep this file in sync with apps/api/.env.template when adding/removing vars used by the worker.

# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
# Deployed-environment identity: development | staging | production | test.
# staging/production turn on fail-closed validation (no loopback endpoints,
# no cross-environment hosts, no default MinIO credentials). production
# forbids PUSH_TRANSPORT=test; fcm-apns requires the complete credential set
# or the worker fails boot visibly. Railway sets this per environment.
APP_ENV=development
# Baked into the image at build time from RAILWAY_GIT_COMMIT_SHA
# (infra/docker/worker.Dockerfile); used in boot logs.
AUTOTM_COMMIT_SHA=unknown
LOG_LEVEL=info

# ─── Database (Prisma) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://auto_tm:auto_tm_pass@localhost:5432/auto_tm_dev

# ─── Cache + queue ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Object storage (MinIO) ─────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000           # Private server endpoint for worker S3 operations
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://localhost:9000         # Public S3 endpoint; worker keeps it only for env parity

# ─── Push notifications (same as apps/api) ──────────────────────────────
# Required together when PUSH_TRANSPORT=fcm-apns; the worker fails boot on a
# partial set. Private keys may be shell-quoted with escaped \n newlines, e.g.
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Both keys are parsed at boot, so a malformed value crashes startup instead of
# silently failing every send. Never commit real values.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=tm.auto.app
APNS_PRIVATE_KEY=
# true = Apple's production APNS host, false = sandbox. Stated explicitly, never
# guessed from APP_ENV: EAS `internal` builds are signed with production
# entitlements, so staging can hold production tokens. The wrong host answers
# BadDeviceToken, which would deactivate healthy devices.
APNS_PRODUCTION=false

PUSH_TRANSPORT=test                           # fcm-apns | ntfy | test — test is rejected when APP_ENV=production

# ─── Sign-in code email (ADR-0055) ──────────────────────────────────────
# mock records sends in memory and delivers nothing (localhost and tests).
# resend sends through Resend's HTTPS API and requires RESEND_API_KEY and
# EMAIL_FROM, or the worker fails boot. Only the worker ever holds the key.
EMAIL_DRIVER=mock                             # mock | resend
EMAIL_FROM=Carberk <no-reply@autotm.bagtyyar.dev>
# Sends allowed per UTC day, counted in this worker's Redis. Resend Free allows
# 100 a day per account, so staging and production sharing one account must
# split 80 between them.
EMAIL_DAILY_CAP=80
# Sending-only key, one per environment. Set only on the Railway worker service.
RESEND_API_KEY=

# ─── Worker tuning ──────────────────────────────────────────────────────
WORKER_CONCURRENCY_VIDEO_TRANSCODE=1          # ffmpeg is CPU-hungry; 1 per CPU core typical
WORKER_CONCURRENCY_IMAGE_VARIANTS=4
WORKER_CONCURRENCY_PUSH=10
WORKER_CONCURRENCY_NOTIFICATION_FANOUT=2

# ─── ffmpeg ─────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg                            # Override if custom build needed
FFMPEG_THREADS=auto                           # Or specific count

# ─── Orphan cleanup ─────────────────────────────────────────────────────
ORPHAN_CLEANUP_MIN_AGE_HOURS=24
ORPHAN_CLEANUP_CRON=0 3 * * *                 # 03:00 daily (TM time)

# Independent operations watchdog only. Configure the actual monitored mount.
# Unset means disk capacity is unknown, never inferred from the worker filesystem.
# OPERATIONS_DISK_PATH=/mounted-volume
