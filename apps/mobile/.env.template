# apps/mobile — local development environment template (Expo)
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time.
# Never put real secrets here. EAS staging, production-smoke, and production
# API/WS/media values are supplied through EAS environment variables.
# The public web host is committed per build profile in eas.json.

# ─── API connection ─────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3006/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:3006/ws/chat
EXPO_PUBLIC_MEDIA_URL=http://localhost:9000
EXPO_PUBLIC_WEB_URL=http://localhost:3002

# ─── Push transport ─────────────────────────────────────────────────────
EXPO_PUBLIC_PUSH_TRANSPORT=fcm                # fcm | ntfy

# ─── App identity ───────────────────────────────────────────────────────
EXPO_PUBLIC_APP_VERSION=0.1.0
EXPO_PUBLIC_ENV=development                   # development | staging | production

# ─── Deep linking ───────────────────────────────────────────────────────
EXPO_PUBLIC_UNIVERSAL_LINK_DOMAIN=auto.tm
EXPO_PUBLIC_CUSTOM_SCHEME=autotm

# ─── EAS file secrets (remote EAS environments only) ────────────────────
# GOOGLE_SERVICES_JSON and GOOGLE_SERVICES_INFO_PLIST are EAS file variables.
# Their runtime values are temporary file paths created by EAS Build.
# Do not put real Firebase service files or paths in this template.
# GOOGLE_SERVICES_JSON=
# GOOGLE_SERVICES_INFO_PLIST=

# ─── Feature flags (override at build time per environment) ─────────────
EXPO_PUBLIC_VEHICLE_HISTORY_SYNTHETIC=false   # Local informational offer/sample only
EXPO_PUBLIC_FEATURE_360_PHOTOS=false          # Phase 3
EXPO_PUBLIC_FEATURE_INSPECTION_REPORTS=false  # Phase 2
EXPO_PUBLIC_FEATURE_COMPARISONS=false         # Phase 3

# Production-smoke build gate only. Set these independently from Railway
# production domain readback in EAS preview. Hostnames only, no scheme/path.
# The resolved EXPO_PUBLIC_* URLs must match; shared staging URLs fail closed.
# PRODUCTION_SMOKE_API_HOST=
# PRODUCTION_SMOKE_WS_HOST=
# PRODUCTION_SMOKE_MEDIA_HOST=
