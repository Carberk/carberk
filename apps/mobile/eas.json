{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.23.2",
      "pnpm": "12.11.2",
      "env": {
        "EXPO_PUBLIC_PUSH_TRANSPORT": "fcm",
        "EXPO_PUBLIC_APP_VERSION": "2.0.4",
        "EXPO_PUBLIC_CUSTOM_SCHEME": "autotm"
      }
    },
    "staging": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_ENV": "staging",
        "EXPO_PUBLIC_UNIVERSAL_LINK_DOMAIN": "auto.tm",
        "EXPO_PUBLIC_WEB_URL": "https://staging.autotm.bagtyyar.dev"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production-smoke": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_UNIVERSAL_LINK_DOMAIN": "auto.tm",
        "EXPO_PUBLIC_WEB_URL": "https://autotm.bagtyyar.dev"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "ANDROID_APPLICATION_ID": "com.auto_tm.ynamly",
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_UNIVERSAL_LINK_DOMAIN": "auto.tm",
        "EXPO_PUBLIC_WEB_URL": "https://autotm.bagtyyar.dev"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
