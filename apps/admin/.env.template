# apps/admin — environment template

# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Deploy evidence for /healthz (dependency-free deploy health route).
# AUTOTM_COMMIT_SHA is baked into the image at build time from
# RAILWAY_GIT_COMMIT_SHA (infra/docker/admin.Dockerfile); Railway also
# injects RAILWAY_ENVIRONMENT_NAME at runtime. No local setup needed.

# ─── API connection ─────────────────────────────────────────────────────
# Required in production: http(s) API origin, with optional /api/v1 suffix.
# A trailing slash and surrounding whitespace are accepted. No credentials,
# query or fragment. Resolved server-side at startup.
API_BASE_URL=http://localhost:3006

# The ingress must overwrite this header with the actual operator address.
# Use the API's private origin above, or its public edge overwrites our handoff.
CLIENT_IP_HEADER=x-real-ip
CLIENT_IP_TRUSTED_HOPS=1
API_CLIENT_IP_HEADER=x-real-ip
NEXT_PUBLIC_API_URL=http://localhost:3006/api/v1
NEXT_PUBLIC_MINIO_PUBLIC_URL=http://localhost:9000

# Deployment constraint: exactly ONE Node process and ONE Railway replica.
# Keep one replica until a shared session store exists (#746; ADR-0090).
# Session rotation coordination is process-local; restarts can require login.

# ─── Admin specifics ────────────────────────────────────────────────────
# ADMIN_ORIGIN is REQUIRED in production: exact public browser origin.
# No path or trailing slash; a mismatch returns 403 at the TOTP step.
# Used for POST origin validation and login redirects, not the private listener.
ADMIN_ORIGIN=http://localhost:3001
ADMIN_TOTP_ISSUER=Carberk                      # Shown in Google Authenticator app

# ─── Auth session (server-side cookie crypto) ───────────────────────────
SESSION_SECRET=replace_me_with_64_char_random_string

# ─── Telegram bot (alerts, see ADR-0010) ────────────────────────────────
TELEGRAM_BOT_TOKEN=                           # For sending alerts from admin
TELEGRAM_ALERT_CHANNEL=                       # Channel ID for ops alerts
