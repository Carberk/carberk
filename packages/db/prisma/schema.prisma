datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma/client"
  moduleFormat = "cjs"
}

/// ============================================================
/// IDENTITY
/// ============================================================

enum UserRole {
  buyer
  seller
  moderator
  admin
}

enum SignInCodeChannel {
  phone
  email
}

model User {
  id          String   @id @default(uuid())
  /// Sign-in Methods (ADR-0054). Each value is stored only with its verified-at
  /// time; the migration adds `users_phone_verified_check` / `users_email_verified_check`.
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  email           String?   @unique
  emailVerifiedAt DateTime?
  displayName String?
  avatarUrl   String?
  locale      String   @default("ru")
  role        UserRole @default(buyer)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  suspendedAt         DateTime?
  suspendedById       String?
  suspendedBy         User?     @relation("UserSuspensions", fields: [suspendedById], references: [id], onDelete: SetNull)
  suspensionReason    String?
  deletionScheduledAt DateTime?

  otpRequests                  OtpRequest[]
  sessions                     Session[]
  dealershipMemberships        DealershipMember[]
  ownedVehicles                OwnedVehicle[]
  blockedUsers                 BlockedUser[]             @relation("Blocker")
  blockedBy                    BlockedUser[]             @relation("Blocked")
  listings                     Listing[]
  favorites                    Favorite[]
  savedSearches                SavedSearch[]
  conversationParticipations   ConversationParticipant[]
  fcmDevices                   FcmDevice[]
  notificationHistory          NotificationHistory[]
  notificationPreferences      NotificationPreference?
  auditLogs                    AuditLog[]
  blogPosts                    BlogPost[]
  conversationsAsBuyer         Conversation[]            @relation("Buyer")
  conversationsAsSeller        Conversation[]            @relation("Seller")
  listingDrafts                ListingDraft[]
  mediaUploads                 MediaUpload[]
  totpEnrollment               TotpEnrollment?
  reportsSubmitted             ContentReport[]           @relation("Reporter")
  reportsReviewed              ContentReport[]           @relation("Reviewer")
  inspectionInterestsRequested InspectionInterest[]      @relation("InspectionInterestRequester")
  suspendedUsers               User[]                    @relation("UserSuspensions")

  @@index([deletionScheduledAt])
  @@map("users")
}

model OtpRequest {
  id         String    @id @default(uuid())
  channel    SignInCodeChannel
  destination String
  /// Temporary deployment compatibility alias. New code reads channel + destination.
  phone      String?
  codeHash   String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  ip         String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([channel, destination, createdAt])
  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@map("otp_requests")
}

model Session {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash   String    @unique
  deviceLabel        String?
  userAgent          String?
  expiresAt          DateTime
  createdAt          DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  adminTotpExpiresAt DateTime?

  @@index([userId])
  @@map("sessions")
}

enum DealershipMemberRole {
  owner
  sales
}

model Dealership {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  logoUrl   String?
  cityId    String?
  city      City?    @relation(fields: [cityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       DealershipMember[]
  ownedVehicles OwnedVehicle[]

  @@map("dealerships")
}

model DealershipMember {
  id           String               @id @default(uuid())
  dealershipId String
  dealership   Dealership           @relation(fields: [dealershipId], references: [id])
  userId       String               @unique
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         DealershipMemberRole
  createdAt    DateTime             @default(now())

  @@map("dealership_members")
}

model OwnedVehicle {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealershipId String?
  dealership   Dealership? @relation(fields: [dealershipId], references: [id])
  brand        String
  model        String
  year         Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("owned_vehicles")
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@map("blocked_users")
}

model TotpEnrollment {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedSecret String
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  backupCodes TotpBackupCode[]

  @@map("totp_enrollments")
}

model TotpBackupCode {
  id               String         @id @default(uuid())
  totpEnrollmentId String
  totpEnrollment   TotpEnrollment @relation(fields: [totpEnrollmentId], references: [id], onDelete: Cascade)
  codeHash         String
  usedAt           DateTime?

  @@map("totp_backup_codes")
}

/// ============================================================
/// CATALOG
/// ============================================================

model Brand {
  id        String   @id @default(uuid())
  slug      String   @unique
  nameRu    String
  nameTk    String
  nameEn    String
  /// Object key in the `catalog-assets` bucket; null means the app shows a letter fallback.
  logoKey   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models   Model[]
  listings Listing[]

  @@map("brands")
}

model Model {
  id        String   @id @default(uuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id])
  slug      String
  nameRu    String
  nameTk    String
  nameEn    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generations Generation[]
  listings    Listing[]

  @@unique([brandId, slug])
  @@map("models")
}

model Generation {
  id        String   @id @default(uuid())
  modelId   String
  model     Model    @relation(fields: [modelId], references: [id])
  nameRu    String
  nameTk    String
  nameEn    String
  yearStart Int?
  yearEnd   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("generations")
}

model Color {
  id        String   @id @default(uuid())
  nameRu    String
  nameTk    String
  nameEn    String
  hex       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("colors")
}

model BodyType {
  id        String   @id @default(uuid())
  nameRu    String
  nameTk    String
  nameEn    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("body_types")
}

model EngineType {
  id        String   @id @default(uuid())
  nameRu    String
  nameTk    String
  nameEn    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings Listing[]

  @@map("engine_types")
}

model Transmission {
  id        String   @id @default(uuid())
  nameRu    String
  nameTk    String
  nameEn    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings Listing[]

  @@map("transmissions")
}

model DriveType {
  id        String   @id @default(uuid())
  nameRu    String
  nameTk    String
  nameEn    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings Listing[]

  @@map("drive_types")
}

model Region {
  id        String   @id @default(uuid())
  slug      String   @unique
  nameRu    String
  nameTk    String
  nameEn    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities   City[]
  listings Listing[]

  @@map("regions")
}

model City {
  id        String   @id @default(uuid())
  regionId  String
  region    Region   @relation(fields: [regionId], references: [id])
  slug      String
  nameRu    String
  nameTk    String
  nameEn    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealerships Dealership[]
  listings    Listing[]

  @@unique([regionId, slug])
  @@map("cities")
}

/// ============================================================
/// LISTINGS
/// ============================================================

enum ListingStatus {
  draft
  pending_review
  active
  sold
  archived
  rejected
  banned
}

enum ListingCondition {
  new
  used
}

enum Currency {
  TMT
  USD
  AED
}

model Listing {
  id            String        @id @default(uuid())
  publicNumber  Int           @unique @default(autoincrement())
  sellerId      String
  seller        User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status        ListingStatus @default(draft)
  brandId       String
  brand         Brand         @relation(fields: [brandId], references: [id])
  modelId       String
  model         Model         @relation(fields: [modelId], references: [id])
  generationId  String?
  colorId       String?
  bodyTypeId    String?
  cityId        String
  city          City          @relation(fields: [cityId], references: [id])
  year          Int?
  mileageKm     Int?
  priceAmount   Float
  priceCurrency Currency      @default(TMT)
  /// priceAmount converted to TMT at the current exchange rate; drives price sort and range.
  priceTmt      Float?
  description   String?
  deletedAt     DateTime?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // S4 additions
  vin                  String?
  condition            ListingCondition?
  engineTypeId         String?
  engineType           EngineType?       @relation(fields: [engineTypeId], references: [id])
  transmissionId       String?
  transmission         Transmission?     @relation(fields: [transmissionId], references: [id])
  driveTypeId          String?
  driveType            DriveType?        @relation(fields: [driveTypeId], references: [id])
  enginePower          Int?
  regionId             String?
  region               Region?           @relation(fields: [regionId], references: [id])
  locationText         String?
  soldAt               DateTime?
  viewCount            Int               @default(0)
  favoriteCount        Int               @default(0)
  contactPhone         String?
  allowCalls           Boolean           @default(true)
  allowChat            Boolean           @default(true)
  acceptsExchange      Boolean           @default(false)
  installmentAvailable Boolean           @default(false)
  archivedByDeletion   Boolean           @default(false)

  // Seller condition disclosure (ADR-0052). `damaged` is nullable only so the
  // migration applies to existing rows; publish and edit require it.
  damaged         Boolean?
  knownIssuesText String?

  media               ListingMedia[]
  favorites           Favorite[]
  conversations       Conversation[]
  inspectionInterests InspectionInterest[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, priceTmt, id])
  @@index([status, year, id])
  @@index([status, mileageKm, id])
  @@index([brandId, modelId, status])
  @@index([cityId, status])
  @@map("listings")
}

enum MediaKind {
  image
  video
}

model ListingMedia {
  id         String    @id @default(uuid())
  listingId  String
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  kind       MediaKind
  key        String
  sortOrder  Int
  width      Int?
  height     Int?
  durationMs Int?
  posterKey  String?
  createdAt  DateTime  @default(now())

  // The server-recorded upload this row adopted (ADR-0079). One row per upload.
  // Null only for legacy rows that duplicated a key already owned by another
  // row: removing such a row never deletes storage objects.
  uploadId String?      @unique
  upload   MediaUpload? @relation(fields: [uploadId], references: [id], onDelete: NoAction)

  @@index([listingId, sortOrder])
  @@map("listing_media")
}

/// Provenance of a presigned upload (ADR-0079). Presign creates the row for the
/// calling User; a ListingMedia row adopts it at most once. A key without a row
/// authorizes nothing, and deletion authority follows the adopting row.
model MediaUpload {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String        @unique
  kind        MediaKind
  contentType String
  // Null for rows backfilled from media that existed before the table.
  sizeBytes   Int?
  createdAt   DateTime      @default(now())
  media       ListingMedia?

  @@index([userId, createdAt])
  @@map("media_uploads")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@map("favorites")
}

model ListingDraft {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
  @@map("listing_drafts")
}

model ExchangeRate {
  id           String   @id @default(uuid())
  fromCurrency Currency
  toCurrency   Currency
  rate         Float
  updatedAt    DateTime @updatedAt
  setByUserId  String?

  @@unique([fromCurrency, toCurrency])
  @@map("exchange_rates")
}

/// ============================================================
/// SUBSCRIPTIONS
/// ============================================================

model SavedSearch {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  filters      Json
  pushEnabled  Boolean   @default(true)
  lastDigestAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@map("saved_searches")
}

/// ============================================================
/// CONVERSATIONS
/// ============================================================

enum MessageKind {
  text
  image
  post_ref
  system
}

model Conversation {
  id            String    @id @default(uuid())
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User      @relation("Buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        User      @relation("Seller", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?
  lastMessageId String?

  participants ConversationParticipant[]
  messages     Message[]

  @@unique([listingId, buyerId])
  @@index([sellerId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id              String       @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  mutedAt         DateTime?
  lastReadAt      DateTime?
  lastDeliveredAt DateTime?

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
  @@index([userId, lastDeliveredAt])
  @@map("conversation_participants")
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  kind            MessageKind
  body            String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  deletedAt       DateTime?
  clientMessageId String?

  @@index([conversationId, createdAt])
  @@unique([conversationId, senderId, clientMessageId])
  @@map("messages")
}

/// ============================================================
/// NOTIFICATIONS
/// ============================================================

enum PushPlatform {
  android
  ios
  web
}

model FcmDevice {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         String       @unique
  platform      PushPlatform
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deviceId      String?
  registeredAt  DateTime     @default(now())
  lastUsedAt    DateTime     @default(now())
  invalidatedAt DateTime?

  @@index([userId])
  @@index([userId, invalidatedAt])
  @@map("fcm_devices")
}

enum NotificationCategory {
  direct_messages
  saved_search_matches
  listing_activity
  admin_announcements
  blog_activity
  marketing
}

enum NotificationHistoryStatus {
  pending
  delivered
  failed
}

model NotificationHistory {
  id              String                    @id @default(uuid())
  userId          String
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        NotificationCategory
  status          NotificationHistoryStatus @default(pending)
  title           String
  body            String
  data            Json?
  deliveryDetails Json?
  readAt          DateTime?
  createdAt       DateTime                  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("notification_history")
}

model NotificationPreference {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  optOuts Json

  @@map("notification_preferences")
}

/// ============================================================
/// CONTENT
/// ============================================================

model BlogPost {
  id          String    @id @default(uuid())
  slug        String    @unique
  locale      String
  title       String
  body        String
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([locale, publishedAt(sort: Desc)])
  @@map("blog_posts")
}

/// ============================================================
/// ADMIN
/// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([createdAt, id])
  @@index([action, createdAt, id])
  @@index([targetType, targetId, createdAt, id])
  @@map("audit_logs")
}

model ContentReport {
  id             String    @id @default(uuid())
  reporterUserId String?
  reporter       User?     @relation("Reporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  targetType     String
  targetId       String
  reason         String
  details        String?
  status         String    @default("pending")
  reviewedById   String?
  reviewedBy     User?     @relation("Reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  messageContext Json?

  @@index([status, createdAt, id])
  @@index([targetType, targetId, status])
  @@index([reporterUserId, createdAt, id])
  @@map("content_reports")
}

/// ============================================================
/// REPORTS
/// ============================================================

model InspectionInterest {
  id                  String   @id @default(uuid())
  listingId           String   @map("listing_id")
  requesterUserId     String   @map("requester_user_id")
  side                String
  willingnessToPayTmt Int?     @map("willingness_to_pay_tmt")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requester User    @relation("InspectionInterestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)

  @@unique([listingId, requesterUserId])
  @@index([listingId, createdAt])
  @@index([requesterUserId, createdAt])
  @@map("inspection_interests")
}
