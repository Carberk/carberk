  supportCaseId String? @unique
  supportCase SupportCase? @relation(fields: [supportCaseId], references: [id], onDelete: Restrict)
  historyRequestId String? @unique
  historyRequest VehicleHistoryRequest? @relation(fields: [historyRequestId], references: [id], onDelete: Restrict)
  lifecycleEpoch Int @default(0)
  lastSequence Int @default(0)
  erasedAt DateTime?
  createdAt DateTime @default(now())
  messages ServiceMessage[]
  attachments ServiceAttachment[]
  readStates ServiceReadState[]
  outbox ServiceOutbox[]
  pushSubscriptions ServicePushSubscription[]
  erasureFence ServiceErasureFence?
  @@map("service_conversations")
}
model ServicePushSubscription {
  id String @id @default(uuid())
  sessionId String
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  deviceId String
  device FcmDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  conversationId String
  conversation ServiceConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  lifecycleEpoch Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([sessionId, deviceId, conversationId])
  @@index([conversationId, lifecycleEpoch])
  @@index([sessionId, deviceId])
  @@map("service_push_subscriptions")
}
model ServiceMessage {
  id String @id @default(uuid())
  conversationId String
  conversation ServiceConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sequence Int
  clientMessageId String
  senderId String?
  sender User? @relation("ServiceMessageAuthor", fields: [senderId], references: [id], onDelete: SetNull)
  senderKind String
  visibility String @default("customer")
  body String?
  attachmentId String? @unique
  attachment ServiceAttachment? @relation("ServiceMessageAttachment", fields: [attachmentId], references: [id], onDelete: Restrict)
  requestHash String
  createdAt DateTime @default(now())
  @@unique([conversationId, senderId, clientMessageId])
  @@unique([conversationId, sequence])
  @@index([conversationId, createdAt])
