}
model ServiceAttachment {
  id String @id @default(uuid())
  conversationId String
  conversation ServiceConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  uploaderId String?
  uploader User? @relation("ServiceUploadOwner", fields: [uploaderId], references: [id], onDelete: SetNull)
  lifecycleEpoch Int
  category String
  visibility String
  state String @default("staged")
  stagingKey String @unique
  objectKey String? @unique
  contentType String
  expectedBytes Int
  sizeBytes Int?
  sha256 String?
  filename String
  rights Json
  createdAt DateTime @default(now())
  expiresAt DateTime
  adoptedAt DateTime?
  removedAt DateTime?
  message ServiceMessage? @relation("ServiceMessageAttachment")
  @@index([state, expiresAt])
  @@map("service_attachments")
}
model ServiceReadState {
  conversationId String
  conversation ServiceConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSequence Int @default(0)
  updatedAt DateTime @updatedAt
  @@id([conversationId, userId])
  @@map("service_read_states")
}
model ServiceAudit {
  id String @id @default(uuid())
  actorId String?
  actor User? @relation("ServiceAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  purpose String
  resourceId String
  action String
  reason String?
  targetStaffId String?
  assignmentVersion Int?
  createdAt DateTime @default(now())
  @@index([purpose, resourceId, createdAt])
  @@map("service_audits")
}
model ServiceOutbox {
  id String @id @default(uuid())
  conversationId String
  conversation ServiceConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  eventType String
  sequence Int
  visibility String
  lifecycleEpoch Int
  createdAt DateTime @default(now())
  deliveredAt DateTime?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  @@unique([conversationId, eventType, sequence])
  @@index([deliveredAt, nextAttemptAt])
  @@map("service_outbox")
}
model ServiceErasureFence {
  conversationId String @id
  conversation ServiceConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  epoch Int
  objectKeys Json
  erasedAt DateTime @default(now())
  cleanupCompletedAt DateTime?
  @@map("service_erasure_fences")
}


/// One center and one plan. Operational approval is separate from software preparation.
model DiagnosticCenter {
  id String @id @default(uuid())
  code String @unique @default("ashgabat")
  planCode String @default("standard")
  names Json
  operationalApproval Json?
  createdAt DateTime @default(now())
  assignments DiagnosticCenterAssignment[]
  templates DiagnosticTemplateVersion[]
  orders InspectionOrder[]
  audits DiagnosticAudit[]
  @@map("diagnostic_centers")
}

model DiagnosticCenterAssignment {
  id String @id @default(uuid())
  centerId String
  center DiagnosticCenter @relation(fields: [centerId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  capability String
  qualifiedUntil DateTime?
  assignedAt DateTime @default(now())
  revokedAt DateTime?
  @@unique([centerId, userId, capability])
  @@index([userId, revokedAt])
  @@map("diagnostic_center_assignments")
}

/// Published content never changes. Attribution can be erased independently.
model DiagnosticTemplateVersion {
  id String @id @default(uuid())
  centerId String
  center DiagnosticCenter @relation(fields: [centerId], references: [id], onDelete: Restrict)
  version Int
  definition Json
  synthetic Boolean @default(true)
  publishedById String?
  publishedBy User? @relation("DiagnosticTemplatePublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt DateTime @default(now())
  orders InspectionOrder[]
  reports DiagnosticReportRecord[]
  @@unique([centerId, version])
  @@map("diagnostic_template_versions")
}

model InspectionOrder {
  sourceAnchor DiagnosticSourceAnchor?
  ownershipGrant DiagnosticOwnershipGrant?
  continuityRequests DiagnosticContinuityRequest[]
  id String @id @default(uuid())
  centerId String
  center DiagnosticCenter @relation(fields: [centerId], references: [id], onDelete: Restrict)
  templateVersionId String
  templateVersion DiagnosticTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  commissionerId String?
  commissioner User? @relation("DiagnosticCommissioner", fields: [commissionerId], references: [id], onDelete: SetNull)
  requestKey String
  audience String
  listingId String?
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  status String @default("requested")
  version Int @default(0)
  epoch String @default(uuid())
  physicalAuthorization Json?
  publicationAuthorization Json?
  observedVehicle Json?
  listingIdentityDigest String?
  associationValidatedAt DateTime?
  /// Monotonic structured identity-evidence generation: appends and erasure/rights invalidation.
  identityEvidenceGeneration Int @default(0)
  synthetic Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  erasedAt DateTime?
  assignments DiagnosticOrderAssignment[]
  reports DiagnosticReportRecord[]
  audits DiagnosticAudit[]
  identityRecords DiagnosticIdentityRecord[]
  identityEvidence DiagnosticIdentityEvidence[]
  identityProvenance DiagnosticIdentityProvenance[]
  continuityProofCandidates DiagnosticContinuityProof[] @relation("ContinuityProofCandidate")
  @@unique([commissionerId, requestKey])
  @@index([commissionerId, createdAt(sort: Desc)])
  @@index([centerId, status, createdAt])
  @@index([listingId, audience])
  @@map("inspection_orders")
}

/// Center capability alone grants no access to a buyer-private commission.
model DiagnosticOrderAssignment {
  id String @id @default(uuid())
  orderId String
  order InspectionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  capability String
  assignedAt DateTime @default(now())
  revokedAt DateTime?
  @@unique([orderId, userId, capability])
  @@index([userId, revokedAt])
  @@map("diagnostic_order_assignments")
}

/// Restricted, append-only physical identity observation of one visit, bound to
/// the order version its write produced. Erasure clears content; nothing rewrites it.
model DiagnosticIdentityRecord {
  id String @id
  orderId String
  order InspectionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderVersion Int
  observation Json?
  observationHash String?
  recordedById String?
  recordedBy User? @relation("DiagnosticIdentityRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedAt DateTime
  erasedAt DateTime?
  reports DiagnosticReportRecord[]
  evidence DiagnosticIdentityEvidence[]
  ownership DiagnosticOwnershipComponent?
  /// Server-only transaction receipt for forward component INSERT, not an ownership history witness.
  ownershipCaptureTransaction String?
  @@unique([orderId, orderVersion])
  @@index([recordedById])
  @@map("diagnostic_identity_records")
}

/// Classified upload intent recorded before bytes, then one exact sanitized private object.
/// Shares the report-evidence object namespace; ids are disjoint across both owners.
model DiagnosticIdentityProvenance {
  id String @id
  orderId String
  order InspectionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  contentType String
  declaredSizeBytes Int
  rights Json?
  rightsUntil DateTime
  objectKey String? @unique
  sha256 String?
  sizeBytes Int?
  mime String?
  state String @default("staged")
  epoch String @default(uuid())
  writeLeaseUntil DateTime?
  cleanupLeaseUntil DateTime?
  cleanupAttempts Int @default(0)
  cleanupFailureCode String?
  createdById String?
  createdBy User? @relation("DiagnosticIdentityProvenanceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  verifiedAt DateTime?
  cleanupRequestedAt DateTime?
  cleanupCompletedAt DateTime?
  erasedAt DateTime?
  @@index([orderId, state])
  @@index([createdById])
  @@map("diagnostic_identity_provenance")
}

/// Restricted immutable structured identity evidence. A correction is a complete new record
/// with one explicit predecessor; erasure clears content in place and nothing rewrites it.
model DiagnosticIdentityEvidence {
  id String @id
  orderId String
  order InspectionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderVersion Int
  identityRecordId String
  identityRecord DiagnosticIdentityRecord @relation(fields: [identityRecordId], references: [id], onDelete: Cascade)
  observationHash String?
  identifiers Json?
  provenance Json?
  rights Json?
  rightsUntil DateTime
  supersedesId String? @unique
  supersedes DiagnosticIdentityEvidence? @relation("DiagnosticIdentityCorrections", fields: [supersedesId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  successor DiagnosticIdentityEvidence? @relation("DiagnosticIdentityCorrections")
  explanation String?
  recordHash String?
  recordedById String?
  recordedBy User? @relation("DiagnosticIdentityEvidenceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedAt DateTime
  erasedAt DateTime?
  reports DiagnosticReportRecord[]
  @@unique([orderId, orderVersion])
  @@index([identityRecordId])
  @@index([recordedById])
  @@map("diagnostic_identity_evidence")
}

/// Content-free state transitions. Consent, identifiers and observations stay private.
model DiagnosticAudit {
  id String @id @default(uuid())
  centerId String
  center DiagnosticCenter @relation(fields: [centerId], references: [id], onDelete: Restrict)
  orderId String?
  order InspectionOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorId String?
  actor User? @relation("DiagnosticAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action String
  details Json
  createdAt DateTime @default(now())
  @@index([orderId, createdAt])
  @@map("diagnostic_audits")
}

