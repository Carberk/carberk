{
  "name": "@auto-tm/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "clean": "rm -rf dist",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx src/seed.ts",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "listing-prices:recompute": "tsx scripts/recompute-listing-prices.ts",
    "reviewer:scenario": "tsx scripts/reviewer-scenario.ts",
    "demo-inventory": "tsx scripts/demo-inventory.ts",
    "photos:convert-webp": "tsx scripts/convert-photos-webp.ts",
    "photos:backfill-thumbhashes": "tsx scripts/backfill-thumbhashes.ts",
    "demo-inventory:credits": "tsx scripts/demo-inventory-credits.ts",
    "ui:fixture": "tsx scripts/ui-fixture.ts",
    "logos:import": "tsx scripts/import-brand-logos.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.e2e.spec.ts' --exclude '**/tests/**' --passWithNoTests",
    "tester:accounts": "tsx scripts/tester-accounts.ts"
  },
  "dependencies": {
    "@auto-tm/contracts": "workspace:*",
    "@prisma/client": "^7.6.0",
    "@prisma/adapter-pg": "^7.6.0",
    "pg": "^8.13.1",
    "thumbhash": "0.1.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.0"
  },
  "devDependencies": {
    "@auto-tm/tsconfig": "workspace:*",
    "@auto-tm/eslint-config": "workspace:*",
    "prisma": "^7.6.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/pg": "^8.11.10",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "eslint": "^9.18.0",
    "dotenv": "17.4.2",
    "@aws-sdk/client-s3": "^3.1048.0",
    "sharp": "^0.34.5",
    "simple-icons": "16.33.0",
    "testcontainers": "^10.28.0"
  }
}
