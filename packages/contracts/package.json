{
  "name": "@auto-tm/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run --passWithNoTests",
    "openapi:generate": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "zod": "catalog:",
    "@asteasolutions/zod-to-openapi": "^7.3.0"
  },
  "devDependencies": {
    "@auto-tm/tsconfig": "workspace:*",
    "@auto-tm/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "typescript": "catalog:",
    "eslint": "catalog:"
  }
}
