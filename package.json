{
  "name": "auto-tm-rewrite",
  "version": "0.1.0",
  "private": true,
  "description": "AutoTM \u2014 Turkmenistan car marketplace (rewrite). Monorepo for API, web, admin, mobile, SMS gateway, phone agent, worker.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "^12.11.2"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "node --test 'infra/minio/*.test.mjs' && pnpm test:agent-github && pnpm test:native-pr-seed && pnpm test:native-session && pnpm test:worktree-gc && pnpm test:agent-docs && pnpm test:glossary && turbo run test && pnpm test:reviewer-flow-smoke",
    "test:unit": "pnpm test:agent-github && pnpm test:native-session && turbo run test:unit",
    "test:api": "turbo run test --continue=dependencies-successful --filter=@auto-tm/api --filter=@auto-tm/worker",
    "test:db": "turbo run test --filter=@auto-tm/db",
    "test:frontend": "turbo run test --filter=@auto-tm/mobile --filter=@auto-tm/web --filter=@auto-tm/admin --filter=@auto-tm/contracts --filter=@auto-tm/sms-gateway",
    "test:root": "pnpm check:agent-docs && node --test 'scripts/*.test.mjs' 'infra/minio/*.test.mjs'",
    "typecheck": "turbo run typecheck",
    "check:glossary": "node scripts/check-domain-glossary.mjs",
    "test:glossary": "node --test scripts/check-domain-glossary.test.mjs",
    "test:ci-lane": "node --test scripts/ci-lane.test.mjs",
    "check:runtime-imports": "node scripts/check-runtime-imports.cjs",
    "smoke:reviewer-flow": "node scripts/staging-reviewer-flow-smoke.mjs",
    "test:reviewer-flow-smoke": "node --test scripts/staging-reviewer-flow-smoke.test.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @auto-tm/db generate",
    "db:migrate:dev": "pnpm --filter @auto-tm/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @auto-tm/db migrate:deploy",
    "db:seed": "pnpm --filter @auto-tm/db seed",
    "compose:up": "docker compose -f infra/compose/docker-compose.dev.yml up -d",
    "compose:down": "docker compose -f infra/compose/docker-compose.dev.yml down",
    "compose:logs": "docker compose -f infra/compose/docker-compose.dev.yml logs -f",
    "minio:bootstrap": "node infra/minio/bootstrap.mjs",
    "minio:backup": "node infra/minio/backup.mjs",
    "minio:restore": "node infra/minio/restore.mjs",
    "check:agent-docs": "node scripts/check-agent-docs.mjs",
    "test:agent-docs": "pnpm check:agent-docs && node --test scripts/check-agent-docs.test.mjs",
    "native:seed": "node scripts/native-pr-seed.mjs",
    "test:native-pr-seed": "node --test scripts/native-pr-seed.test.mjs",
    "worktree:gc": "node scripts/worktree-gc.mjs",
    "worktree:gc:apply": "node scripts/worktree-gc.mjs --apply",
    "test:worktree-gc": "node --test scripts/worktree-gc.test.mjs",
    "agent:github": "node scripts/agent-github.mjs",
    "test:agent-github": "node --test scripts/agent-github.test.mjs",
    "test:native-session": "node --test scripts/native-session*.test.mjs",
    "staging:control": "node scripts/staging.mjs",
    "test:staging-control": "node --test scripts/staging-clean-reset.test.mjs scripts/staging.test.mjs scripts/staging-control.test.mjs scripts/staging-ledger.test.mjs scripts/staging-railway.test.mjs"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "tsx": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
