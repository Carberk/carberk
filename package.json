{
  "name": "auto-tm-rewrite",
  "version": "0.1.0",
  "private": true,
  "description": "AutoTM \u2014 Turkmenistan car marketplace (rewrite). Monorepo for API, web, admin, mobile, SMS gateway, phone agent, worker.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "^12.11.2"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "pnpm check:source-policy && pnpm check:import-architecture && turbo run lint",
    "test": "pnpm test:root && turbo run test",
    "test:unit": "pnpm test:agent-github && pnpm test:native-session && pnpm test:native-fixture-signin && pnpm test:admin-access && turbo run test:unit",
    "test:api": "turbo run test --filter=@auto-tm/api --filter=@auto-tm/worker",
    "test:api:unit": "DATABASE_URL=postgresql://auto_tm_ci:auto_tm_ci_pass@127.0.0.1:1/auto_tm_ci pnpm --filter @auto-tm/api... build && pnpm --filter @auto-tm/api test:unit",
    "test:db": "turbo run test --filter=@auto-tm/db",
    "test:frontend": "turbo run test --filter=@auto-tm/mobile --filter=@auto-tm/web --filter=@auto-tm/admin --filter=@auto-tm/contracts --filter=@auto-tm/sms-gateway",
    "test:root": "pnpm exec turbo run build --filter=@auto-tm/contracts && pnpm check:agent-docs && node --test 'scripts/*.test.mjs' 'infra/minio/*.test.mjs'",
    "typecheck": "turbo run typecheck",
    "check:glossary": "node scripts/check-domain-glossary.mjs",
    "test:glossary": "node --test scripts/check-domain-glossary.test.mjs",
    "test:ci-lane": "node --test scripts/ci-lane.test.mjs",
    "check:runtime-imports": "node scripts/check-runtime-imports.cjs",
    "smoke:reviewer-flow": "pnpm exec turbo run build --filter=@auto-tm/contracts && node scripts/staging-reviewer-flow-smoke.mjs",
    "test:reviewer-flow-smoke": "pnpm exec turbo run build --filter=@auto-tm/contracts && node --test scripts/staging-reviewer-flow-smoke.test.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @auto-tm/db generate",
    "db:migrate:dev": "pnpm --filter @auto-tm/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @auto-tm/db migrate:deploy",
    "db:seed": "pnpm --filter @auto-tm/db canonical:seed",
    "compose:up": "docker compose -f infra/compose/docker-compose.dev.yml up -d",
    "compose:down": "docker compose -f infra/compose/docker-compose.dev.yml down",
    "compose:logs": "docker compose -f infra/compose/docker-compose.dev.yml logs -f",
    "minio:bootstrap": "node infra/minio/bootstrap.mjs",
    "minio:backup": "node infra/minio/backup.mjs",
    "minio:restore": "node infra/minio/restore.mjs",
    "check:agent-docs": "node scripts/check-agent-docs.mjs",
    "test:agent-docs": "pnpm check:agent-docs && node --test scripts/check-agent-docs.test.mjs",
    "native:seed": "node scripts/native-pr-seed.mjs",
    "sim:spare": "node scripts/spare-simulator.mjs",
    "test:spare-simulator": "node --test scripts/spare-simulator.test.mjs",
    "test:native-pr-seed": "node --test scripts/native-pr-seed.test.mjs",
    "worktree:gc": "node scripts/worktree-gc.mjs",
    "worktree:gc:apply": "node scripts/worktree-gc.mjs --apply",
    "test:worktree-gc": "node --test scripts/worktree-gc.test.mjs",
    "agent:github": "node scripts/agent-github.mjs",
    "test:agent-github": "node --test scripts/agent-github.test.mjs",
    "test:native-session": "node --test scripts/native-session*.test.mjs",
    "native:signin": "node scripts/native-fixture-signin.mjs",
    "test:native-fixture-signin": "node --test scripts/native-fixture-signin.test.mjs",
    "native:ready": "pnpm --filter @auto-tm/db fixture:check",
    "admin:access": "node scripts/admin-access.mjs",
    "test:admin-access": "node --test scripts/admin-access.test.mjs scripts/admin-access-process.test.mjs",
    "check:source-policy": "node scripts/check-source-policy.mjs",
    "test:source-policy": "node --test scripts/check-source-policy.test.mjs",
    "check:import-architecture": "node scripts/check-import-architecture.mjs",
    "test:import-architecture": "node --test scripts/check-import-architecture.test.mjs"
  },
  "devDependencies": {
    "@auto-tm/contracts": "workspace:*",
    "@aws-sdk/client-s3": "3.1048.0",
    "@aws-sdk/s3-request-presigner": "3.1048.0",
    "@babel/parser": "7.29.7",
    "@lumis-sh/wasm-groovy": "0.26.5",
    "@lumis-sh/wasm-kotlin": "0.26.5",
    "@lumis-sh/wasm-swift": "0.26.5",
    "@typescript/native": "catalog:",
    "dockerfile-ast": "0.7.1",
    "mvdan-sh": "0.10.1",
    "parse5": "7.3.0",
    "postcss": "8.5.6",
    "query-string": "7.1.3",
    "saxes": "6.0.0",
    "socket.io-client": "4.8.3",
    "tsx": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "web-tree-sitter": "0.26.13",
    "ws": "8.21.0",
    "yaml": "2.8.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
